{
  "manifest_version": 1,
  "dependencies": {
    "ffmpeg": {
      "name": "ffmpeg",
      "display_name": "FFmpeg",
      "description": "Audio/video processing toolkit",
      "required": true,
      "platforms": {
        "windows": {
          "package_managers": [
            {
              "id": "winget",
              "priority": 1,
              "detect_command": "winget",
              "detect_args": ["--version"],
              "install_command": "winget",
              "install_args": ["install", "--id", "FFmpeg.FFmpeg", "--silent", "--accept-package-agreements", "--accept-source-agreements"],
              "needs_elevation": false
            },
            {
              "id": "choco",
              "priority": 2,
              "detect_command": "choco",
              "detect_args": ["--version"],
              "install_command": "choco",
              "install_args": ["install", "ffmpeg", "-y"],
              "needs_elevation": true
            }
          ]
        },
        "macos": {
          "package_managers": [
            {
              "id": "brew",
              "priority": 1,
              "detect_command": "brew",
              "detect_args": ["--version"],
              "install_command": "brew",
              "install_args": ["install", "ffmpeg"],
              "needs_elevation": false
            }
          ]
        },
        "linux": {
          "package_managers": [
            {
              "id": "apt",
              "priority": 1,
              "detect_command": "apt",
              "detect_args": ["--version"],
              "install_command": "sudo",
              "install_args": ["apt", "install", "-y", "ffmpeg"],
              "needs_elevation": true
            },
            {
              "id": "dnf",
              "priority": 2,
              "detect_command": "dnf",
              "detect_args": ["--version"],
              "install_command": "sudo",
              "install_args": ["dnf", "install", "-y", "ffmpeg"],
              "needs_elevation": true
            },
            {
              "id": "pacman",
              "priority": 3,
              "detect_command": "pacman",
              "detect_args": ["--version"],
              "install_command": "sudo",
              "install_args": ["pacman", "-S", "--noconfirm", "ffmpeg"],
              "needs_elevation": true
            }
          ]
        }
      }
    },
    "python": {
