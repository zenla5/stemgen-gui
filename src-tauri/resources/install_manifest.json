      "required": true,
      "platforms": {
        "windows": {
          "package_managers": [
            {
              "id": "pip",
              "priority": 1,
              "detect_command": "python",
              "detect_args": ["-c", "import torch"],
              "install_command": "python",
              "install_args": ["-m", "pip", "install", "--user", "torch", "torchaudio"],
              "needs_elevation": false
