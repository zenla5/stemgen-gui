              "needs_elevation": false
            }
          ]
        },
        "linux": {
          "package_managers": [
            {
              "id": "apt",
              "priority": 1,
              "detect_command": "apt",
              "detect_args": ["--version"],
              "install_command": "sudo",
              "install_args": ["apt", "install", "-y", "python3", "python3-pip", "python3-venv"],
              "needs_elevation": true
